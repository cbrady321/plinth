{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plinth.local/schemas/pipeline_config.schema.json",
  "title": "PipelineConfig",
  "type": "object",
  "required": ["name", "version", "dag"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "input_source": { "type": "string" },
    "dag": { "$ref": "#/$defs/dagNode" },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "export_flags": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "block_settings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "status": { "type": "string" },
    "hierarchy_enabled": { "type": "boolean" },
    "hierarchy_schema": { "type": ["object", "null"] },
    "start_from_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "end_at_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "parallel_error_policy": {
      "type": "string",
      "enum": ["fail_fast", "continue"]
    },
    "always_propagate": { "type": "boolean" },
    "flow_arming": { "$ref": "#/$defs/flowArming" }
  },
  "$defs": {
    "flowArming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disarmed_ports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parallel_policies": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parallelFanInPolicy" }
        }
      }
    },
    "parallelFanInPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wait_mode": {
          "type": "string",
          "enum": ["wait_all", "wait_armed"]
        },
        "combine_mode": {
          "type": "string",
          "enum": ["aggregate", "passthrough"]
        },
        "armed_children": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        }
      }
    },
    "dagNode": {
      "oneOf": [
        { "$ref": "#/$defs/stageNode" },
        { "$ref": "#/$defs/sequentialBlock" },
        { "$ref": "#/$defs/parallelBlock" }
      ]
    },
    "stageNode": {
      "type": "object",
      "required": ["type", "name"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "stage" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "sequentialBlock": {
      "type": "object",
      "required": ["type", "name", "children"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "sequential" },
        "name": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dagNode" }
        }
      }
    },
    "parallelBlock": {
      "type": "object",
      "required": ["type", "name", "children"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "parallel" },
        "name": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dagNode" }
        }
      }
    }
  }
}
